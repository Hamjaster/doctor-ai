# Copy to .env and fill in.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Gemini Live, the default voice, and medical lookups. https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Fallbacks. Without them the agent still runs; the backup models on LiveKit Inference use the
# LiveKit credentials above.
# Speech-to-text and text-to-speech when every realtime model fails. https://console.deepgram.com
DEEPGRAM_API_KEY=
# LLM for that same fallback. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Nearby hospitals. A Google Cloud key with the Places API (New) enabled; the AI Studio key
# above is rejected. Without it the agent uses free OpenStreetMap data, which is less complete.
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_MAPS_API_KEY=
# Optional overrides, comma-separated and tried in order. Names with a "/" go through LiveKit Inference.
# SAATHI_LIVE_MODELS=gemini-3.8-live,gemini-2.5-flash-native-audio-latest,openai/gpt-realtime-2.1-mini
# SAATHI_PIPELINE_LLMS=google/gemini-3.8-flash,openai/gpt-4.1-mini
# Start every call on the fallback pipeline (no camera), e.g. if Gemini Live misbehaves mid-demo.
# SAATHI_VOICE=pipeline
