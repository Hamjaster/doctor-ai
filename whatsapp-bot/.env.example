# Copy to .env and fill in; README.md says where each value comes from.
OPENROUTER_API_KEY=
# Any image-capable model from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.8-flash
# Link the bot sends for a live video consultation
VIDEO_CALL_URL=
# Shared with WAHA through docker-compose.yml. Use a different random string for each: openssl rand -hex 16
WAHA_API_KEY=
WAHA_HMAC_KEY=
WAHA_DASHBOARD_PASSWORD=
# WAHA image: "arm" on Apple Silicon Macs, "latest" on Intel/AMD machines
WAHA_TAG=arm
# Optional, defaults to ./bot.db (chat history + seen message ids)
# DB_PATH=bot.db
# Shared with the web app (HANDOFF_SECRET in its .env.local) so it can read a chat when a
# patient opens their video link. Use a random string: openssl rand -hex 24
HANDOFF_SECRET=
