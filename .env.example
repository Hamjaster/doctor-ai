# Copy to .env.local and fill in.

# LiveKit credentials for the token endpoint (app/api/token/route.ts), from your project's
# Settings > API keys page in LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# WhatsApp number patients message or call to reach doctor.ai, digits only with country code
# (e.g. 923001234567). With the WAHA bot in whatsapp-bot/, use the number linked to WAHA.
# Leave blank to show setup instructions instead of the WhatsApp hand-off.
SAATHI_WHATSAPP_NUMBER=

# Video links sent from the WhatsApp bot (whatsapp-bot/). Same value as HANDOFF_SECRET there.
HANDOFF_SECRET=
# Where the bot runs, if not http://localhost:8000
# WHATSAPP_BOT_URL=
